# AI Messaging — central server configuration
# Copy to `.env` (git-ignored) and fill in. Never commit the real file.

# REQUIRED. The Tailscale IP of the machine hosting the server.
# Find yours with:  tailscale ip -4
# The server refuses to start on 0.0.0.0, public IPs, or anything
# outside the Tailscale address ranges. This is the security model:
# the tailnet perimeter IS the trust boundary.
AIM_HOST=100.64.0.1

# TCP port to listen on inside the tailnet.
AIM_PORT=8422

# Where the SQLite database lives (created on first start).
AIM_DB_PATH=./data/aim.db

# Optional. Messages older than this many days are permanently deleted
# (checked at startup and once per hour). Unset or 0 = keep everything.
# Whatever you choose, the active policy is declared by GET /health —
# retention is explicit, never a silent disappearance.
#AIM_RETENTION_DAYS=90

# Dev/tests ONLY. Allows binding on 127.0.0.1 to run the server locally
# without a tailnet. Never set this on a real deployment.
#AIM_ALLOW_LOOPBACK=1
